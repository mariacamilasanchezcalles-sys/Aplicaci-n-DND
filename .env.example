# Copia este archivo como .env.local y rellena los datos de la app web de tu
# proyecto de Firebase (Consola de Firebase > Configuración del proyecto >
# Tus apps > App web). No son secretos: la seguridad la dan el inicio de
# sesión y firestore.rules. Si se dejan vacíos, se guarda solo en el dispositivo.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
