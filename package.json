{
  "name": "dnd-tactical-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simulador táctico de combate de D&D (núcleo de reglas y prototipo de pantallas)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.app.json --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run build && npm run build:web && npm run test"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "firebase": "13.1.0"
  }
}
